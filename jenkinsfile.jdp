pipeline {
    agent any
    stages {
        stage('pull'){
            steps {
                git branch: 'dev', url: 'https://github.com/guru6910/Backend-CRM.git'
            }
        }
        stage('build'){
            steps {
                sh '/opt/maven/bin/mvn clean package'
            }
        }
        stage('docker-build'){
            steps {
                sh '''
                    docker build . -t guru6910/b18-backend:latest
                    docker push guru6910/b18-backend:latest
                    docker rmi guru6910/b18-backend:latest
                '''
            }
        }
        stage('deploy'){
            steps {
                sh '''
                    kubectl apply -f ./yaml/
                '''
            }
        }
    }
}
