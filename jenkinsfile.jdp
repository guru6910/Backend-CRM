pipeline {
    agent any
    stages {
        stage('pull'){
            steps {
                git branch: 'dev', url: 'https://github.com/guru6910/Backend-CRM.git'
            }
        }
        stage('build'){
            steps {
                sh '/opt/maven/apache-maven-3.8.8/bin/mvn clean package -Dmaven.test.skip=true'
            }
        }
        stage('docker-build'){
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker_cred', passwordVariable: 'passwd', usernameVariable: 'uname')]) {
                sh ''
                    docker build . -t guru6910/b18-backend:latest
                    docker push guru6910/b18-backend:latest
                ''
                }
            }
        }
        stage('deploy'){
            steps {
                sh '''
                    kubectl apply -f ./yaml/
                '''
            }
        }
    }
}
